---
// Sidebar author card component
---

<aside class="w-full lg:w-72 shrink-0 space-y-6">
  <!-- Profile Card -->
  <div class="bg-white dark:bg-obsidian-800 rounded-2xl p-6 border border-slate-200 dark:border-obsidian-border shadow-xs hover:border-matcha-300 dark:hover:border-matcha-accent/40 transition-all">
    <!-- Avatar -->
    <div class="relative w-28 h-28 mx-auto mb-4 group">
      <div class="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-matcha-400 to-sakura-400 opacity-70 blur-xs group-hover:opacity-100 transition duration-300"></div>
      <img
        src="/images/profile.png"
        alt="Lennart Trunk"
        class="relative w-full h-full object-cover rounded-2xl border-2 border-white dark:border-obsidian-850 shadow-md"
      />
    </div>

    <!-- Name & Title -->
    <div class="text-center space-y-1.5">
      <h1 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
        Lennart Trunk
      </h1>
      <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
        he/him
      </p>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-matcha-50 dark:bg-matcha-accent/15 text-matcha-700 dark:text-matcha-accent border border-matcha-200 dark:border-matcha-accent/30">
        <span class="w-1.5 h-1.5 rounded-full bg-matcha-500 animate-pulse"></span>
        Ph.D. Researcher
      </div>
    </div>

    <!-- Affiliation & Lab -->
    <div class="mt-5 pt-4 border-t border-slate-100 dark:border-obsidian-border space-y-2.5 text-xs text-slate-600 dark:text-slate-300">
      <div class="flex items-start gap-2.5">
        <svg class="w-4 h-4 text-matcha-600 dark:text-matcha-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        <div>
          <p class="font-semibold text-slate-800 dark:text-slate-200">Institute of Science Tokyo</p>
          <p class="text-[11px] text-slate-400 dark:text-slate-500">東京科学大学 (formerly Tokyo Tech)</p>
        </div>
      </div>

      <div class="flex items-start gap-2.5">
        <svg class="w-4 h-4 text-sakura-500 dark:text-sakura-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <div>
          <div class="flex items-center gap-1.5 flex-wrap">
            <a
              href="https://www.arch.cs.titech.ac.jp"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-matcha-600 dark:text-matcha-accent hover:underline flex items-center gap-1"
            >
              ArchLab (吉瀬研究室)
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
            <span class="text-slate-300 dark:text-slate-600">•</span>
            <a
              href="https://github.com/archlab-sciencetokyo"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[11px] text-slate-500 hover:text-slate-900 dark:hover:text-white hover:underline font-mono"
              title="ArchLab GitHub Organization"
            >
              GitHub
            </a>
          </div>
          <p class="text-[11px] text-slate-400 dark:text-slate-500">Architecture Laboratory</p>
        </div>
      </div>

      <div class="flex items-center gap-2.5">
        <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Tokyo, Japan 🌸</span>
      </div>
    </div>

    <!-- Social Action Buttons -->
    <div class="mt-5 pt-4 border-t border-slate-100 dark:border-obsidian-border space-y-2">
      <a
        href="https://github.com/renshi-code"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold bg-slate-50 dark:bg-obsidian-850 hover:bg-matcha-50 dark:hover:bg-matcha-accent/15 border border-slate-200 dark:border-obsidian-border hover:border-matcha-300 dark:hover:border-matcha-accent/40 text-slate-700 dark:text-slate-200 hover:text-matcha-700 dark:hover:text-matcha-accent transition-all group"
      >
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span>GitHub</span>
        </div>
        <span class="text-[11px] text-slate-400 group-hover:text-matcha-600 dark:group-hover:text-matcha-accent font-mono">@renshi-code</span>
      </a>

      <a
        href="https://www.linkedin.com/in/lennart-trunk-85ab7014a"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold bg-slate-50 dark:bg-obsidian-850 hover:bg-matcha-50 dark:hover:bg-matcha-accent/15 border border-slate-200 dark:border-obsidian-border hover:border-matcha-300 dark:hover:border-matcha-accent/40 text-slate-700 dark:text-slate-200 hover:text-matcha-700 dark:hover:text-matcha-accent transition-all group"
      >
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 fill-current text-[#0077b5]" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          <span>LinkedIn</span>
        </div>
        <span class="text-[11px] text-slate-400 group-hover:text-matcha-600 dark:group-hover:text-matcha-accent">Connect &rarr;</span>
      </a>

      <a
        href="https://bsky.app/profile/renshi.me"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold bg-slate-50 dark:bg-obsidian-850 hover:bg-matcha-50 dark:hover:bg-matcha-accent/15 border border-slate-200 dark:border-obsidian-border hover:border-matcha-300 dark:hover:border-matcha-accent/40 text-slate-700 dark:text-slate-200 hover:text-matcha-700 dark:hover:text-matcha-accent transition-all group"
      >
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 fill-current text-[#1185fe]" viewBox="0 0 24 24"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566 1.01 1.053 1.455.334 2.146-.386 2.836.031 4.502.502 5.656c1.343 3.284 3.904 4.887 5.72 5.093-2.316.035-4.884.97-5.836 2.65-.953 1.68-.456 3.491.439 4.316 1.43 1.32 4.416 1.574 7.175-.415 2.759 1.989 5.745 1.735 7.175.415.895-.825 1.392-2.636.439-4.316-.952-1.68-3.52-2.615-5.836-2.65 1.816-.206 4.377-1.809 5.72-5.093.471-1.154.888-2.82.168-3.51-.719-.691-2.232-1.136-4.868.659C16.046 4.747 13.087 8.686 12 10.8z"/></svg>
          <span>Bluesky</span>
        </div>
        <span class="text-[11px] text-slate-400 group-hover:text-matcha-600 dark:group-hover:text-matcha-accent font-mono">@renshi.me</span>
      </a>

      <a
        href="mailto:trunk.l.588d@m.isct.ac.jp"
        class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold bg-slate-50 dark:bg-obsidian-850 hover:bg-matcha-50 dark:hover:bg-matcha-accent/15 border border-slate-200 dark:border-obsidian-border hover:border-matcha-300 dark:hover:border-matcha-accent/40 text-slate-700 dark:text-slate-200 hover:text-matcha-700 dark:hover:text-matcha-accent transition-all group"
      >
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          <span>Email</span>
        </div>
        <span class="text-[11px] text-slate-400 group-hover:text-matcha-600 dark:group-hover:text-matcha-accent">Get in touch &rarr;</span>
      </a>
    </div>

    <!-- Research Focus Tags -->
    <div class="mt-5 pt-4 border-t border-slate-100 dark:border-obsidian-border">
      <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2">
        Focus Areas
      </h3>
      <div class="flex flex-wrap gap-1.5">
        <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
          Computer Architecture
        </span>
        <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
          RTL Simulation
        </span>
        <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
          RISC-V Microarchitecture
        </span>
        <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
          Compiler Optimization
        </span>
        <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
          FPGA Prototyping
        </span>
      </div>
    </div>
  </div>
</aside>
