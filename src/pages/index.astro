---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout
  title="Lennart Trunk — Computer Architecture & RISC-V Researcher"
  description="Ph.D. student researching Computer Architecture, RTL Simulation Acceleration, and RISC-V at Institute of Science Tokyo (ArchLab)"
>
  <div class="flex flex-col lg:flex-row gap-8 items-start">
    <!-- Left Column: Author Profile Sidebar -->
    <Sidebar />

    <!-- Right Column: Main Content Area -->
    <main class="flex-1 min-w-0 space-y-10">
      <!-- Hero Section -->
      <section class="space-y-5">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-sakura-50 dark:bg-sakura-600/15 text-sakura-600 dark:text-sakura-400 border border-sakura-200 dark:border-sakura-500/30">
            初めまして
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-matcha-50 dark:bg-matcha-accent/15 text-matcha-700 dark:text-matcha-accent border border-matcha-200 dark:border-matcha-accent/30">
            Kise Laboratory (ArchLab)
          </span>
          <a
            href="https://www.arch.cs.titech.ac.jp"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-slate-500 dark:text-slate-400 hover:text-matcha-600 dark:hover:text-matcha-accent flex items-center gap-1"
          >
            東京科学大学 • 吉瀬研 &rarr;
          </a>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
          Accelerating Digital Hardware Simulation &amp; RISC-V Microarchitecture
        </h1>

        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
          Hello! I am <strong class="font-semibold text-slate-900 dark:text-white">Lennart Trunk</strong>, a Computer Science (情報工学コース) Ph.D. student at
          <a href="https://www.isct.ac.jp" target="_blank" rel="noopener noreferrer" class="text-matcha-700 dark:text-matcha-accent hover:underline font-medium">Institute of Science Tokyo</a>
          (東京科学大学, formerly Tokyo Tech) in the
          <a href="https://www.arch.cs.titech.ac.jp" target="_blank" rel="noopener noreferrer" class="text-matcha-700 dark:text-matcha-accent hover:underline font-medium">Kise Laboratory (ArchLab / 吉瀬研究室)</a>.
        </p>

        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          My research investigates compiler-driven acceleration of Verilog RTL simulation, high-performance cycle-accurate RISC-V CPU modeling with modern C++ coroutines, and custom instruction hardware-software co-design.
        </p>

        <!-- Quick Action Nav Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="/portfolio"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold bg-matcha-600 hover:bg-matcha-700 text-white shadow-sm hover:shadow transition-all"
          >
            <span>Explore Portfolio</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="/publications"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold bg-white dark:bg-obsidian-800 hover:bg-slate-50 dark:hover:bg-obsidian-750 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-obsidian-border hover:border-matcha-300 dark:hover:border-matcha-accent/40 shadow-sm transition-all"
          >
            <span>Publications</span>
            <span class="w-2 h-2 rounded-full bg-sakura-500"></span>
          </a>
          <a
            href="/cv"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold bg-white dark:bg-obsidian-800 hover:bg-slate-50 dark:hover:bg-obsidian-750 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-obsidian-border hover:border-matcha-300 dark:hover:border-matcha-accent/40 shadow-sm transition-all"
          >
            <span>Curriculum Vitae</span>
          </a>
        </div>
      </section>

      <!-- Featured Research Bento Box -->
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
            Research &amp; Highlights
          </h2>
          <span class="text-xs text-slate-400 dark:text-slate-500">Selected work &amp; milestones</span>
        </div>

        <!-- Outer Bento Tray -->
        <div class="rounded-3xl p-3 sm:p-3.5 bg-slate-100/80 dark:bg-obsidian-850/90 border border-slate-200/90 dark:border-obsidian-border shadow-inner">
          <div class="grid grid-cols-1 md:grid-cols-6 gap-3">
            <!-- Compartment 1: SimRV (4 cols, Flagship Project) -->
            <div class="md:col-span-4 group bg-white dark:bg-obsidian-800 rounded-2xl p-5 sm:p-6 border border-slate-200/80 dark:border-obsidian-border hover:border-matcha-400 dark:hover:border-matcha-accent/50 shadow-sm transition-all flex flex-col justify-between relative overflow-hidden">
              <div class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-bl from-matcha-400/10 dark:from-matcha-accent/10 to-transparent pointer-events-none rounded-bl-full"></div>

              <div class="space-y-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-xs font-bold uppercase tracking-wider bg-matcha-50 dark:bg-matcha-accent/15 text-matcha-700 dark:text-matcha-accent border border-matcha-200 dark:border-matcha-accent/30">
                      Featured Project
                    </span>
                    <span class="text-xs font-mono text-slate-500 dark:text-slate-400">C++23 • MIT</span>
                  </div>
                  <span class="text-xs font-medium text-matcha-600 dark:text-matcha-accent">Open Source Simulator</span>
                </div>

                <div>
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-matcha-600 dark:group-hover:text-matcha-accent transition-colors">
                    <a href="https://github.com/archlab-sciencetokyo/SimRV" target="_blank" rel="noopener noreferrer">
                      SimRV: Dual-Width Explainable RISC-V System Simulator
                    </a>
                  </h3>
                  <p class="mt-1.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                    An explainable, dual-width (<code>RV32GCBV</code> / <code>RV64GCBV</code>) RISC-V research simulator with functional &amp; cycle-accurate modes, full-system Linux boot, Spike lockstep co-simulation, and a split-screen terminal workbench (TUI).
                  </p>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 pt-1">
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                    RISC-V (RV32/RV64)
                  </span>
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                    C++23
                  </span>
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                    Full-System Linux
                  </span>
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                    Terminal UI
                  </span>
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                    Hardware/Software Codesign
                  </span>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-100 dark:border-obsidian-border flex flex-wrap items-center gap-3 text-xs font-semibold">
                <a
                  href="https://github.com/archlab-sciencetokyo/SimRV"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-matcha-600 dark:text-matcha-accent hover:underline flex items-center gap-1"
                >
                  <span>GitHub (archlab-sciencetokyo/SimRV)</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                </a>
                <a
                  href="https://archlab-sciencetokyo.github.io/SimRV/stable/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white flex items-center gap-1"
                >
                  <span>Docs</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                </a>
                <a
                  href="/portfolio"
                  class="ml-auto text-slate-500 hover:text-matcha-600 dark:hover:text-matcha-accent"
                >
                  Portfolio &rarr;
                </a>
              </div>
            </div>

            <!-- Compartment 2: IEEE MCSoC 2026 (2 cols, compact vertical accent tile) -->
            <div class="md:col-span-2 group bg-gradient-to-b from-sakura-50/60 to-white dark:from-sakura-600/10 dark:to-obsidian-800 rounded-2xl p-5 border border-sakura-200/70 dark:border-sakura-500/30 hover:border-sakura-400 dark:hover:border-sakura-400/60 shadow-sm transition-all flex flex-col justify-between">
              <div class="space-y-2.5">
                <div class="flex items-center justify-between gap-2">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider bg-sakura-100/80 dark:bg-sakura-600/20 text-sakura-700 dark:text-sakura-300 border border-sakura-200 dark:border-sakura-500/30">
                    MCSoC 2026
                  </span>
                  <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400">#254</span>
                </div>

                <h3 class="text-base font-bold text-slate-900 dark:text-white leading-snug group-hover:text-sakura-600 dark:group-hover:text-sakura-400 transition-colors">
                  SimRV: An Explainable RISC-V Full-System Simulator
                </h3>

                <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                  For Architecture Education &amp; Hardware/Software Codesign.
                </p>

                <div class="pt-1 space-y-1 text-[11px] font-mono text-slate-600 dark:text-slate-300">
                  <div>Dec 17, 2026 · 12:05 (UTC+8)</div>
                  <div class="text-slate-500 dark:text-slate-400">Session A16 · Room A</div>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-sakura-200/50 dark:border-sakura-500/20 flex items-center justify-between text-xs font-semibold">
                <a href="https://mcsoc-forum.org/site/index.php/program-2/" target="_blank" rel="noopener noreferrer" class="text-sakura-600 dark:text-sakura-400 hover:underline">Program &nearr;</a>
                <a href="/publications" class="text-slate-500 hover:text-sakura-600 dark:hover:text-sakura-400">Details &rarr;</a>
              </div>
            </div>

            <!-- Compartment 3: KitsuneRV (3 cols) -->
            <div class="md:col-span-3 group bg-white dark:bg-obsidian-800 rounded-2xl p-5 border border-slate-200/80 dark:border-obsidian-border hover:border-matcha-400 dark:hover:border-matcha-accent/50 shadow-sm transition-all flex flex-col justify-between">
              <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider bg-amber-50 dark:bg-amber-500/15 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-500/30">
                    Upcoming
                  </span>
                  <span class="text-xs font-mono text-slate-500 dark:text-slate-400">SystemVerilog</span>
                </div>

                <div>
                  <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-matcha-600 dark:group-hover:text-matcha-accent transition-colors">
                    KitsuneRV
                  </h3>
                  <p class="mt-1 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                    Upcoming SystemVerilog RTL FPGA batch kernel for accelerating SimRV cycle-accurate simulation on AMD/Xilinx Alveo U50.
                  </p>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                    Alveo U50
                  </span>
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                    Verilator
                  </span>
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                    Vitis RTL
                  </span>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-100 dark:border-obsidian-border flex items-center justify-between text-xs font-semibold">
                <span class="text-slate-400 dark:text-slate-500">Repository releasing soon</span>
                <a href="/portfolio" class="text-slate-500 hover:text-matcha-600 dark:hover:text-matcha-accent">Portfolio &rarr;</a>
              </div>
            </div>

            <!-- Compartment 4: VCC Compiler (3 cols, earlier/starter project) -->
            <div class="md:col-span-3 group bg-white dark:bg-obsidian-800 rounded-2xl p-5 border border-slate-200/80 dark:border-obsidian-border hover:border-matcha-400 dark:hover:border-matcha-accent/50 shadow-sm transition-all flex flex-col justify-between">
              <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                    IEICE Technical Report
                  </span>
                  <span class="text-xs font-mono text-slate-500 dark:text-slate-400">Jan 2026</span>
                </div>

                <div>
                  <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-matcha-600 dark:group-hover:text-matcha-accent transition-colors">
                    VCC: Verilog HDL Compiler
                  </h3>
                  <p class="mt-1 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                    Earlier starter project translating Verilog HDL circuits into optimized native simulation code for accelerated RTL simulation.
                  </p>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                    Verilog HDL
                  </span>
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                    RTL Simulation
                  </span>
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                    C++ Compilation
                  </span>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-100 dark:border-obsidian-border flex items-center justify-between text-xs font-semibold">
                <a
                  href="https://www.ieice.org/publications/search/summary.php?id=141053&tbl=ken&lang=en"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-matcha-600 dark:text-matcha-accent hover:underline"
                >
                  IEICE #141053 &nearr;
                </a>
                <a href="/publications" class="text-slate-500 hover:text-matcha-600 dark:hover:text-matcha-accent">Publications &rarr;</a>
              </div>
            </div>

            <!-- Compartment 5: Academic Path (Full Width 6 cols) -->
            <div class="md:col-span-6 bg-white dark:bg-obsidian-800 rounded-2xl p-5 border border-slate-200/80 dark:border-obsidian-border shadow-sm">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-xs font-bold uppercase tracking-wider bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                    Academic Path
                  </span>
                  <span class="text-xs text-slate-500 dark:text-slate-400">Tokyo &amp; Hannover</span>
                </div>
                <a href="/cv" class="text-xs font-semibold text-matcha-600 dark:text-matcha-accent hover:underline">
                  View Full Timeline &rarr;
                </a>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-obsidian-850 border border-slate-100 dark:border-obsidian-border">
                  <p class="font-bold text-slate-800 dark:text-slate-200">Doctor of Philosophy</p>
                  <p class="text-slate-500 dark:text-slate-400 mt-0.5">Institute of Science Tokyo</p>
                  <p class="text-[11px] text-matcha-600 dark:text-matcha-accent mt-1">Sep 2025 — Present</p>
                  <p class="text-[11px] text-slate-400 mt-1">Kise Laboratory (ArchLab)</p>
                </div>

                <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-obsidian-850 border border-slate-100 dark:border-obsidian-border">
                  <p class="font-bold text-slate-800 dark:text-slate-200">YSEP Exchange</p>
                  <p class="text-slate-500 dark:text-slate-400 mt-0.5">Tokyo Institute of Technology</p>
                  <p class="text-[11px] text-sakura-600 dark:text-sakura-400 mt-1">Sep 2023 — Aug 2024 · Exchange Student</p>
                  <p class="text-[11px] text-slate-400 mt-1">ArchLab (Kise Laboratory)</p>
                </div>

                <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-obsidian-850 border border-slate-100 dark:border-obsidian-border">
                  <p class="font-bold text-slate-800 dark:text-slate-200">M.Sc. &amp; B.Sc. Computer Engineering</p>
                  <p class="text-slate-500 dark:text-slate-400 mt-0.5">Leibniz University Hannover</p>
                  <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">M.Sc. Oct 2022 — Sep 2025</p>
                  <p class="text-[11px] text-slate-400 mt-0.5">B.Sc. Oct 2014 — Sep 2022</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Research Pillars Section -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
          Research Pillars
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 rounded-2xl bg-white dark:bg-obsidian-800 border border-slate-200 dark:border-obsidian-border hover:border-matcha-300 dark:hover:border-matcha-accent/40 shadow-sm transition-all space-y-2">
            <div class="w-8 h-8 rounded-lg bg-matcha-50 dark:bg-matcha-accent/15 text-matcha-600 dark:text-matcha-accent flex items-center justify-center font-bold text-base">
              ⚡
            </div>
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">RTL Simulation Acceleration</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Domain-specific compilers for Verilog HDL, topological scheduling, and memory layout optimization for simulation kernels.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-obsidian-800 border border-slate-200 dark:border-obsidian-border hover:border-matcha-300 dark:hover:border-matcha-accent/40 shadow-sm transition-all space-y-2">
            <div class="w-8 h-8 rounded-lg bg-sakura-50 dark:bg-sakura-600/15 text-sakura-600 dark:text-sakura-400 flex items-center justify-center font-bold text-base">
              🖥️
            </div>
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">RISC-V Microarchitecture</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Full-system RV32/RV64 simulation, 5-stage cycle-oriented coroutine pipelines, live hazard/cache explainability, and hardware/software codesign.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-obsidian-800 border border-slate-200 dark:border-obsidian-border hover:border-matcha-300 dark:hover:border-matcha-accent/40 shadow-sm transition-all space-y-2">
            <div class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 flex items-center justify-center font-bold text-base">
              ⚙️
            </div>
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">FPGA Prototyping</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Synthesis and physical emulation of RISC-V cores and accelerated compute units on Xilinx / AMD UltraScale+ and Kintex platforms.
            </p>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>
