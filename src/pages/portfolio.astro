---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout
  title="Portfolio & Research Projects — Lennart Trunk"
  description="Research projects, compiler tools, and open-source hardware simulators developed by Lennart Trunk at Institute of Science Tokyo."
>
  <div class="flex flex-col lg:flex-row gap-8 items-start">
    <Sidebar />

    <main class="flex-1 min-w-0 space-y-8">
      <!-- Page Header -->
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-matcha-50 dark:bg-matcha-accent/15 text-matcha-700 dark:text-matcha-accent border border-matcha-200 dark:border-matcha-accent/30">
            Research &amp; Engineering
          </span>
          <span class="text-xs text-slate-400 dark:text-slate-500 font-mono">Portfolio</span>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Projects &amp; Systems
        </h1>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300">
          Domain-specific compilers for digital simulation, cycle-accurate RISC-V processor simulators, and FPGA prototyping platforms developed at ArchLab, Science Tokyo.
        </p>
      </div>

      <!-- Project Cards Grid -->
      <div class="space-y-6">
        <!-- Project 1: VCC -->
        <article class="bg-white dark:bg-obsidian-800 rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-obsidian-border hover:border-matcha-400 dark:hover:border-matcha-accent/50 shadow-xs transition-all space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-xs font-bold uppercase tracking-wider bg-matcha-50 dark:bg-matcha-accent/15 text-matcha-700 dark:text-matcha-accent border border-matcha-200 dark:border-matcha-accent/30">
                Featured • 論文
              </span>
              <span class="px-2 py-0.5 rounded-md text-xs font-mono bg-slate-100 dark:bg-obsidian-850 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-obsidian-border">
                IEICE Jan 2026
              </span>
            </div>
            <span class="text-xs text-slate-400 dark:text-slate-500">ArchLab • 東京科学大学</span>
          </div>

          <div>
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
              VCC: Verilog HDL Compiler for Accelerated RTL Simulation
            </h2>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              <strong>VCC</strong> is a dedicated hardware description language compiler developed at the Kise Laboratory (ArchLab), Institute of Science Tokyo. Its core objective is eliminating the severe runtime bottlenecks inherent to traditional event-driven Register-Transfer Level (RTL) circuit simulation.
            </p>
          </div>

          <div class="space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
            <h3 class="font-bold text-slate-900 dark:text-white uppercase tracking-wider text-[11px]">Key Architectural Capabilities</h3>
            <ul class="list-disc list-inside space-y-1 text-slate-600 dark:text-slate-300">
              <li><strong>RTL Acceleration:</strong> Compiles synthesizable Verilog HDL directly into optimized native simulation code, delivering orders of magnitude speedups over conventional interpretive simulators.</li>
              <li><strong>Compiler Optimizations:</strong> Performs static analysis, topological signal dependency scheduling, and parallel execution optimizations specifically tailored for hardware verification.</li>
              <li><strong>Rigorous Evaluation:</strong> Benchmarked across extensive test suites including standard digital circuits and full RISC-V processor designs.</li>
            </ul>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
              Verilog HDL
            </span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
              RTL Simulation
            </span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
              Compiler Techniques
            </span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
              IEICE RECONF / VLD
            </span>
          </div>

          <div class="pt-4 border-t border-slate-100 dark:border-obsidian-border flex flex-wrap items-center gap-3">
            <a
              href="https://www.ieice.org/publications/search/summary.php?id=141053&tbl=ken&lang=en"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-matcha-600 hover:bg-matcha-700 text-white shadow-xs transition-colors"
            >
              <span>IEICE Summary (#141053)</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
            <a
              href="https://ken.ieice.org/ken/paper/20260127ocqa/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-obsidian-850 hover:bg-slate-200 dark:hover:bg-obsidian-750 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-obsidian-border transition-colors"
            >
              <span>IEICE Paper Record (2026-01-27)</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
            <a
              href="https://www.arch.cs.titech.ac.jp"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-semibold text-matcha-600 dark:text-matcha-accent hover:underline ml-auto"
            >
              ArchLab &rarr;
            </a>
          </div>
        </article>

        <!-- Project 2: SimRV -->
        <article class="bg-white dark:bg-obsidian-800 rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-obsidian-border hover:border-matcha-400 dark:hover:border-matcha-accent/50 shadow-xs transition-all space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-xs font-bold uppercase tracking-wider bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
                Open Source Simulator
              </span>
              <span class="px-2 py-0.5 rounded-md text-xs font-mono bg-sakura-50 dark:bg-sakura-600/15 text-sakura-600 dark:text-sakura-400 border border-sakura-200 dark:border-sakura-500/30">
                IEEE MCSoC 2026
              </span>
            </div>
            <span class="text-xs text-slate-400 dark:text-slate-500">C++20 Coroutines</span>
          </div>

          <div>
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
              SimCore / RISC-V (SimRV) — Modular RISC-V CPU Simulator
            </h2>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              <a href="https://github.com/archlab-sciencetokyo/SimRV" target="_blank" rel="noopener noreferrer" class="text-matcha-600 dark:text-matcha-accent hover:underline font-semibold">SimRV</a> 
              is an open-source RISC-V CPU simulator developed and maintained at ArchLab, Science Tokyo. Active since 2018, it serves as the foundation for microarchitecture exploration, instruction extension validation, and hardware/software co-design.
            </p>
          </div>

          <div class="space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
            <h3 class="font-bold text-slate-900 dark:text-white uppercase tracking-wider text-[11px]">Core Features &amp; Research Focus</h3>
            <ul class="list-disc list-inside space-y-1 text-slate-600 dark:text-slate-300">
              <li><strong>Modular ISA Simulation:</strong> RV32I / RV64I instruction set simulation with full support for integer, multiply, compressed, and atomic extensions.</li>
              <li><strong>Cycle-Accurate Coroutine Pipeline:</strong> 5-stage in-order pipeline model capturing structural hazards, data stalls, and branch penalties with high simulation throughput.</li>
              <li><strong>Custom Function Unit (CFU):</strong> Seamless plug-and-play framework for evaluating custom instructions and domain-specific hardware accelerators.</li>
              <li><strong>RTL Behavioral Parity:</strong> Instruction trace validation directly verified against synthesizable Verilog processor designs simulated in Verilator.</li>
            </ul>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-2">
            <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
              C++20
            </span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
              RISC-V (RV32/64)
            </span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
              Pipeline Simulation
            </span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
              CFU Extensions
            </span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-obsidian-850 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-obsidian-border">
              Verilator Co-Verification
            </span>
          </div>

          <div class="pt-4 border-t border-slate-100 dark:border-obsidian-border flex flex-wrap items-center gap-3">
            <a
              href="https://github.com/archlab-sciencetokyo/SimRV"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-900 shadow-xs transition-colors"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              <span>GitHub Repository</span>
            </a>
            <a
              href="https://www.arch.cs.titech.ac.jp"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-obsidian-850 hover:bg-slate-200 dark:hover:bg-obsidian-750 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-obsidian-border transition-colors"
            >
              <span>ArchLab Lab Website</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </div>
        </article>
      </div>
    </main>
  </div>
</Layout>
